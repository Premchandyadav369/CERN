{
  "name": "cern-x",
  "version": "1.0.0-alpha",
  "type": "module",
  "private": true,
  "description": "CERN-X: Interactive, open-source digital representation of CERN's scientific ecosystem",
  "author": "Premchand Yadav <premchand.23bce7167@vitapstudent.ac.in>",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
